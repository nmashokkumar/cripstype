# ==============================================================================
# Flow Open-Source Backend Configuration
# Copy to .env (install.sh generates this automatically on first run).
# ==============================================================================

# Server port (8000 is automatically exposed by Instabox.sh)
PORT=8000

# Optional API key required from clients (leave blank for open local/private use)
FLOW_API_KEY=

# ASR Engine: "faster_whisper" (fast, low RAM) or "seamless_m4t_v2"
FLOW_ASR_ENGINE=faster_whisper
FLOW_ASR_MODEL=distil-large-v3
FLOW_ASR_DEVICE=auto
FLOW_ASR_COMPUTE_TYPE=int8

# Layer 2 LLM Polisher (any OpenAI-compatible URL: Ollama, vLLM, Groq, OpenAI)
# Leave blank to use the fast built-in deterministic cleaner + dictionary engine.
FLOW_LLM_URL=
FLOW_LLM_MODEL=llama3.2:3b
FLOW_LLM_API_KEY=
FLOW_LLM_TIMEOUT_SEC=15

# CORS origins (comma-separated URLs or "*" for cross-device Electron/APK/Web clients)
FLOW_CORS_ORIGINS=*
