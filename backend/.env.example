# ==============================================================================
# CrispType Open-Source Backend Configuration
# Copy to .env (or run `bash setup.sh` to auto-generate with a random API key).
# NEVER commit .env to git.
# ==============================================================================

# Server listening port
PORT=8000

# Required API key sent by CrispType clients via Authorization: Bearer <key> or X-API-Key
# `bash setup.sh` generates a cryptographically random key automatically.
CRISPTYPE_API_KEY=

# Optional public URL printed by setup.sh (e.g. https://dictate.yourdomain.com)
CRISPTYPE_PUBLIC_URL=

# Stage 1 ASR Engine:
#   "parakeet"        -> NVIDIA Parakeet TDT (requires `pip install onnx-asr` or NeMo)
#   "faster_whisper"  -> Default fast CPU/GPU CTranslate2 Whisper (int8/float16)
#   "seamless_m4t_v2" -> Meta SeamlessM4T v2 multilingual
CRISPTYPE_ASR_ENGINE=faster_whisper
CRISPTYPE_ASR_MODEL=distil-large-v3
CRISPTYPE_ASR_DEVICE=auto
CRISPTYPE_ASR_COMPUTE_TYPE=int8

# Stage 2 LLM Refiner (Llama 3.2 via Ollama, vLLM, llama.cpp, Groq, or any OpenAI-compatible API)
# Example for local Ollama: http://127.0.0.1:11434/v1
# Leave blank to use CrispType's built-in deterministic cleaner + dictionary engine.
CRISPTYPE_LLM_URL=
CRISPTYPE_LLM_MODEL=llama3.2:3b
CRISPTYPE_LLM_API_KEY=
CRISPTYPE_LLM_TIMEOUT_SEC=15

# Explicit CORS allowlist (comma-separated). Wildcard "*" is blocked when API key auth is enabled.
CRISPTYPE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,tauri://localhost,https://tauri.localhost,capacitor://localhost

# Abuse protection limits
CRISPTYPE_RATE_LIMIT_RPM=60
CRISPTYPE_MAX_WS_PER_IP=8

# Log level (INFO or WARNING in production; transcripts are never logged)
CRISPTYPE_LOG_LEVEL=INFO
