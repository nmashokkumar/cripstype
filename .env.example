# ==============================================================================
# CrispType Web / Node Server Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env to git.
# ==============================================================================

# Server port (default: 3000)
PORT="3000"

# Shared secret to protect /health, /transcribe, /v1/audio/transcriptions, and WebSocket streams.
# Clients enter this in Settings -> Server -> API key.
CRISPTYPE_API_KEY=""

# Optional upstream self-hosted STT server (CrispType Python backend, Faster-Whisper, Parakeet, whisper.cpp)
# Examples:
#   http://127.0.0.1:8000/v1   (CrispType / Faster-Whisper / OpenAI-compatible)
#   http://127.0.0.1:8080      (whisper.cpp server -> POST /inference)
UPSTREAM_TRANSCRIBE_URL=""
UPSTREAM_TRANSCRIBE_FORMAT="auto"
UPSTREAM_TRANSCRIBE_MODEL="whisper-1"
UPSTREAM_TRANSCRIBE_API_KEY=""

# Optional OpenAI-compatible Layer 2 LLM endpoint (e.g. Ollama Llama 3.2: http://127.0.0.1:11434/v1)
UPSTREAM_CLEANUP_URL=""
UPSTREAM_CLEANUP_MODEL="llama3.2:3b"
UPSTREAM_CLEANUP_API_KEY=""

# Optional built-in fallback transcription/cleanup API key (when no self-hosted upstream is set)
GEMINI_API_KEY=""

# Explicit CORS allowlist (comma-separated). Wildcard "*" is ignored when CRISPTYPE_API_KEY is set.
CRISPTYPE_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,tauri://localhost,https://tauri.localhost,capacitor://localhost"

# Rate limiting & WebSocket connection caps per IP
CRISPTYPE_RATE_LIMIT_RPM="60"
CRISPTYPE_MAX_WS_PER_IP="8"

# Optional public URL where this server is hosted
APP_URL=""

# Optional default server URL prefilled in the CrispType client Settings -> Server
VITE_CRISPTYPE_API_URL=""
